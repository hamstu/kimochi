# LF everywhere, including Windows checkouts: scripts, configs and fixtures are byte-compared
# (prepare.mjs hashes, test fixtures) and must be identical on every OS.
* text=auto eol=lf

# Binary assets: never normalised or diffed as text.
*.png binary
*.mp3 binary
*.icns binary
*.ico binary
*.onnx binary
*.bin binary
*.safetensors binary
*.dylib binary
*.dll binary
*.so binary
*.exe binary
bin/keytrigger-* binary

# Vendored upstream extension releases (scripts/sync-extension.mjs), stored exactly as released.
# `-text` keeps git from converting line endings: prepare.mjs verifies every byte against
# extensions/<id>.sha256.json, and an upstream file may carry CRLF. Not counted as our code on
# GitHub; the large dictionary data and Wasm files are never diffed.
extensions/** -text linguist-vendored
extensions/**/*.ljson -diff
extensions/**/*.idx -diff
extensions/**/*.wasm -diff
