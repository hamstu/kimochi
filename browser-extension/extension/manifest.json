{
  "manifest_version": 3,
  "name": "Kimochi",
  "short_name": "Kimochi",
  "version": "0.1.0",
  "description": "Read Japanese in images on any page: pick an image, Kimochi reads it, and the text lands on top of it for your dictionary pop-up.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Kimochi: pick an image to read",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "Pick an image to read"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/logo.svg",
        "fonts/figtree.woff2"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": false
    }
  ]
}
