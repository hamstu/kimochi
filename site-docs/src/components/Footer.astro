---
/** Starlight's footer (pagination) plus the marketing site's links and sign-off. */
import Default from '@astrojs/starlight/components/Footer.astro'

const MARKETING = 'https://kimochiapp.com'
const year = new Date().getFullYear()
---

<Default />
<div class="k-footer">
  <nav aria-label="Kimochi">
    <a href={MARKETING}>kimochiapp.com</a>
    <a href={`${MARKETING}/#download`}>Download</a>
    <a href={`${MARKETING}/faq`}>FAQ</a>
    <a href="https://discord.gg/vdMge6TBZQ">Discord</a>
    <a href={`${MARKETING}/privacy`}>Privacy</a>
    <a href={`${MARKETING}/terms`}>Terms</a>
  </nav>
  <p>Made with <span role="img" aria-label="love">❤️</span> in Canada · © {year} Kimochi</p>
</div>

<style>
  .k-footer {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--k-line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    font-size: var(--sl-text-sm);
    color: var(--k-text-3);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  a {
    color: var(--k-text-2);
    text-decoration: none;
  }
  a:hover {
    color: var(--k-text);
  }
  p {
    margin: 0;
  }
</style>
