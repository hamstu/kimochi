---
/** The header's link back to the marketing site, where Starlight puts its social icons. */
---

<a href="https://kimochiapp.com" class="k-home">
  kimochiapp.com
  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg>
</a>

<style>
  .k-home {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--k-text-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .k-home:hover {
    color: var(--k-text);
  }
  svg {
    color: var(--k-text-3);
  }
</style>
