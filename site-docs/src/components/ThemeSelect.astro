---
/**
 * The marketing site's theme control (site/src/components/ThemeToggle.tsx): system, light and dark
 * as a three-way segmented control, in place of Starlight's select. It keeps Starlight's storage
 * ('starlight-theme': '' for system) and sets <html data-theme> the same way.
 */
const OPTIONS = [
  { value: 'auto', label: 'System theme', path: '<rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>' },
  { value: 'light', label: 'Light theme', path: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>' },
  { value: 'dark', label: 'Dark theme', path: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>' }
]
---

<k-theme-toggle role="radiogroup" aria-label="Theme">
  {
    OPTIONS.map(({ value, label, path }) => (
      <button type="button" role="radio" aria-checked="false" aria-label={label} title={label} data-theme-value={value}>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={path} />
      </button>
    ))
  }
</k-theme-toggle>

{/* Inlined so the right button is checked before first paint. */}
<script is:inline>
  {
    const stored = localStorage.getItem('starlight-theme') || 'auto'
    document.querySelectorAll('k-theme-toggle button').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.themeValue === stored)))
  }
</script>

<script>
  type Theme = 'auto' | 'dark' | 'light'
  const KEY = 'starlight-theme'
  const load = (): Theme => {
    const v = localStorage.getItem(KEY)
    return v === 'light' || v === 'dark' ? v : 'auto'
  }
  const resolve = (theme: Theme) =>
    theme === 'auto' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : theme

  function apply(theme: Theme): void {
    document.documentElement.dataset.theme = resolve(theme)
    localStorage.setItem(KEY, theme === 'auto' ? '' : theme)
    document.querySelectorAll<HTMLButtonElement>('k-theme-toggle button').forEach((b) => {
      b.setAttribute('aria-checked', String(b.dataset.themeValue === theme))
    })
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (load() === 'auto') apply('auto')
  })

  class ThemeToggle extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
        b.addEventListener('click', () => apply(b.dataset.themeValue as Theme))
      )
    }
  }
  customElements.define('k-theme-toggle', ThemeToggle)
</script>

<style>
  k-theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    height: 1.75rem;
    padding: 0.125rem;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px var(--k-line);
  }
  button {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--k-text-3);
    cursor: pointer;
    transition: background-color 100ms, color 100ms;
  }
  button:hover {
    background: var(--k-hover);
    color: var(--k-text);
  }
  button[aria-checked='true'] {
    background: var(--k-press);
    color: var(--k-text);
  }
</style>
