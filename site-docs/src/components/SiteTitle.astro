---
/** The marketing site's wordmark (icon + "Kimochi"), with a quiet "Docs" after it. */
import { Image } from 'astro:assets'
import icon from '../assets/kimochi-icon.svg'

const { siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="k-wordmark" aria-label="Kimochi Docs home">
  <Image src={icon} alt="" width={22} height={22} />
  <span class="k-name" translate="no">Kimochi</span>
  <span class="k-docs">Docs</span>
</a>

<style>
  .k-wordmark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--k-text);
    text-decoration: none;
    white-space: nowrap;
  }
  img {
    border-radius: 5px;
  }
  .k-name {
    font-size: 1.0625rem;
    font-weight: var(--k-weight-semibold);
    letter-spacing: -0.01em;
  }
  .k-docs {
    font-size: 1.0625rem;
    font-weight: var(--k-weight-regular);
    color: var(--k-text-3);
    letter-spacing: -0.01em;
  }
</style>
