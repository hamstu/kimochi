---
/**
 * The landing page hero: Starlight's (title, tagline, actions) beside a screenshot of the overlay
 * in the reader's theme, instead of Starlight's square hero image.
 */
import { LinkButton } from '@astrojs/starlight/components'
import Screenshot from './Screenshot.astro'

const { data } = Astro.locals.starlightRoute.entry
const { title = data.title, tagline, actions = [] } = data.hero || {}
---

<div class="k-hero">
  <div class="k-hero-copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="k-hero-tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="k-hero-actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
  <div class="k-hero-shot">
    <Screenshot
      id="overlay-demo"
      alt="A visual novel with Kimochi's overlay: every word of the dialogue boxed, and a dictionary pop-up for 容赦なく under the cursor."
      width={560}
      eager
    />
  </div>
</div>

<style>
  .k-hero {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding-block: 2rem 1rem;
  }
  .k-hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 1.6rem + 3.2vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-weight: var(--k-weight-semibold);
    color: var(--k-text);
    text-wrap: balance;
  }
  .k-hero-tagline {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.55;
    color: var(--k-text-2);
    text-wrap: pretty;
  }
  .k-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .k-hero-shot :global(.k-shot) {
    margin: 0 auto;
  }
  @media (min-width: 50rem) {
    .k-hero {
      grid-template-columns: 5fr 6fr;
      gap: 3rem;
      padding-block: clamp(2.5rem, calc(1rem + 8vmin), 6rem) 2rem;
    }
  }
</style>
