{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimochi",
  "version": "0.1.0",
  "identifier": "dev.kimochi.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/meikiocr/runtime/": "meikiocr/runtime/",
      "resources/meikiocr/LICENSE": "meikiocr/LICENSE",
      "resources/meikiocr/NOTICE": "meikiocr/NOTICE",
      "resources/mangaocr/LICENSE": "mangaocr/LICENSE",
      "resources/mangaocr/LICENSE-APACHE": "mangaocr/LICENSE-APACHE",
      "resources/mangaocr/NOTICE": "mangaocr/NOTICE",
      "resources/mangaocr/model-manifest.json": "mangaocr/model-manifest.json"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
