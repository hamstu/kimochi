{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimochi Next POC",
  "version": "0.1.0",
  "identifier": "dev.kimochi.next-poc",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "resources": {
      "../bin/keytrigger-darwin-arm64": "bin/keytrigger-darwin-arm64",
      "../bin/keytrigger-darwin-amd64": "bin/keytrigger-darwin-amd64"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
