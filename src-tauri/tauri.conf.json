{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimochi",
  "version": "0.1.0",
  "identifier": "dev.kimochi.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1430",
    "beforeDevCommand": {
      "script": "node node_modules/vite/bin/vite.js --config vite.dev.config.ts",
      "cwd": "..",
      "wait": false
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kimochi"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFM0I4MzFBMjY2NDJERjQKUldUMExXUW1Hb003am1IRUg5UG5ERWUzenNPZzJuS05rM1hTUkZQNG9GVWlIZDBKSlRFak14ek0K",
      "endpoints": [
        "https://github.com/hamstu/kimochi-tauri/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/meikiocr/runtime/": "meikiocr/runtime/",
      "resources/meikiocr/LICENSE": "meikiocr/LICENSE",
      "resources/meikiocr/NOTICE": "meikiocr/NOTICE",
      "resources/mangaocr/LICENSE": "mangaocr/LICENSE",
      "resources/mangaocr/LICENSE-APACHE": "mangaocr/LICENSE-APACHE",
      "resources/mangaocr/NOTICE": "mangaocr/NOTICE",
      "resources/mangaocr/model-manifest.json": "mangaocr/model-manifest.json",
      "resources/silero-vad/LICENSE": "silero-vad/LICENSE",
      "../LICENSE": "licenses/LICENSE",
      "../LICENSE-APACHE": "licenses/LICENSE-APACHE",
      "../LICENSE-OFL.txt": "licenses/LICENSE-OFL.txt",
      "../NOTICE": "licenses/NOTICE"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
