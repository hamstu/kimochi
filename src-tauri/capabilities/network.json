{
  "identifier": "kimochi-network",
  "description": "Outbound HTTP for the local Yomitan API, and the dictionary hosts the dictionary engines download from (Yomitan, Hachidori, 10ten) \u2014 the last of which the dictionary settings window needs for imports. Deliberately not a general internet grant.",
  "windows": [
    "overlay",
    "log",
    "settings",
    "dictionary",
    "popup-host",
    "welcome"
  ],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:19633/**"
        },
        {
          "url": "http://127.0.0.1:19633/**"
        },
        {
          "url": "http://localhost:8765/**"
        },
        {
          "url": "http://127.0.0.1:8765/**"
        },
        {
          "url": "https://github.com/**"
        },
        {
          "url": "https://*.githubusercontent.com/**"
        },
        {
          "url": "https://api.jiten.moe/**"
        },
        {
          "url": "https://data.10ten.life/**"
        },
        {
          "url": "https://jitendex.org/**"
        },
        {
          "url": "http://localhost:5050/**"
        },
        {
          "url": "http://127.0.0.1:5050/**"
        }
      ]
    }
  ]
}
