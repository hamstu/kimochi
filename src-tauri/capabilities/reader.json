{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "reader",
  "description": "Texthooker session files, explicit file dialogs, clipboard and external links.",
  "windows": ["log", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-decorations",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "clipboard-manager:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "shell:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "url": "https://**"
        }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-applocaldata-read",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write",
    "fs:allow-applocaldata-write-recursive",
    "fs:allow-applocaldata-meta",
    "fs:allow-applocaldata-meta-recursive",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPLOCALDATA/**"
        }
      ]
    },
    "core:window:allow-hide",
    "core:window:allow-is-always-on-top"
  ]
}
