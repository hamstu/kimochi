{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "category": "Education",
    "shortDescription": "Read and play in Japanese with on-screen OCR, pop-up dictionaries and a reading log",
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "libavif16"
        ]
      }
    }
  }
}
