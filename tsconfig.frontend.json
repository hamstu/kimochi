{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@ui/*": [
        "./ui/*"
      ],
      "@texthooker/*": [
        "./frontend/texthooker/*"
      ],
      "@kit": [
        "./frontend/kit/index.ts"
      ],
      "@kit/*": [
        "./frontend/kit/*"
      ]
    }
  },
  "include": [
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "frontend/**/*.d.ts",
    "vite.config.ts",
    "vite.dev.config.ts"
  ]
}
