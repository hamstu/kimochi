node_modules/
dist/
src-tauri/target/
capture-core/target/
speech-core/target/
src-tauri/gen/
# Machine-local Cargo overrides, e.g. local OCR crate checkouts (CONTRIBUTING.md)
.cargo/config.local.toml
.DS_Store

src-tauri/resources/meikiocr/
src-tauri/resources/mangaocr/
src-tauri/resources/oneocr/

# Vendored dictionary-extension trees (64 MB of upstream bytes). Only the pins and hash records
# (`extensions/<id>.source.json`, `.sha256.json`) are committed; `node scripts/sync-extension.mjs
# --all --if-missing` (run by prepare.mjs for an absent tree, and by CI) refills them.
extensions/*/
oneocr-worker/target/

# Static build of the preview harness for the site demo (npm run demo:build)
site/public/demo/

# Agent worktrees and local tool state
.claude/

# Private working notes stay on the maintainer's machine, never in the repository: plans,
# handoffs, bring-up reports, research and the evidence they collected. Root-level Markdown is
# ignored unless it is one of the public documents listed here.
/docs/
/evidence/
/*.md
!/README.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/COMMANDS.md
!/DESIGN.md
!/PRODUCT.md
!/CLAUDE.md

# Local secrets (e.g. REACTBITS_LICENSE_KEY for the site)
.env.local
