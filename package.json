    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs launch",
    "pretest": "node scripts/sync-extension.mjs --all --if-missing",
    "test": "node --test --test-timeout=120000 scripts/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.frontend.json",
    "lint": "eslint .",
    "format": "prettier --write frontend scripts ui",
    "icons": "node scripts/icons.mjs",
    "verify": "node scripts/prepare.mjs --verify",
    "check:rust": "node scripts/run.mjs check",
    "check:all": "node scripts/run.mjs check:all",
    "trace:summary": "node scripts/trace-report.mjs",
    "trace:mark": "node scripts/trace-report.mjs --mark",
    "test:native:reader-popup": "node scripts/test-reader-popup-native.mjs",
    "prepare:meikiocr": "node scripts/prepare-meikiocr.mjs",
    "prepare:mangaocr": "node scripts/prepare-mangaocr.mjs"
  },
